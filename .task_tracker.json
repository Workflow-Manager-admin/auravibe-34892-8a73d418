{
  "task_description": "{'component_name': 'Main Container for AuraVibe', 'description': 'Primary container for AuraVibe implementation: My AuraGram is a full-stack social media platform inspired by Instagram, designed as a digital aura space where users express their daily emotions, colors, and energy through posts. The app features user authentication (email/Google), profile customization, media uploads (images/videos), interactive feed, real-time notifications, stories, direct messaging, explore page, admin dashboard, and dark/light mode. Built with modern technologies for performance, security, and a vibey, animated UI, it also offers optional features like audio reels, profile themes, AI-generated captions, and more.', 'interfaces': [], 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "AuraVibe-34892 frontend Container",\n  "features": [\n    {\n      "name": "User Authentication",\n      "description": "Sign up and log in with email or Google authentication using Firebase Auth or Auth0.",\n      "isEnabled": true\n    },\n    {\n      "name": "Profile Management",\n      "description": "Create and edit profile with bio, avatar, and username. Choose profile themes and color palettes.",\n      "isEnabled": true\n    },\n    {\n      "name": "Media Uploads",\n      "description": "Upload images and short videos with captions, hashtags, and mood-based filter suggestions. Media stored on Cloudinary or Firebase Storage.",\n      "isEnabled": true\n    },\n    {\n      "name": "Feed",\n      "description": "Scrollable feed of posts from followed users with vibey design, animations, and smooth transitions.",\n      "isEnabled": true\n    },\n    {\n      "name": "Post Interactions",\n      "description": "Like, comment, and save posts. Real-time updates for interactions.",\n      "isEnabled": true\n    },\n    {\n      "name": "Follow System",\n      "description": "Follow and unfollow users to curate your feed.",\n      "isEnabled": true\n    },\n    {\n      "name": "Notifications",\n      "description": "Real-time notifications for likes, comments, and follows using Socket.io or Firebase Realtime DB.",\n      "isEnabled": true\n    },\n    {\n      "name": "Explore Page",\n      "description": "Discover trending content and hashtags. AI-generated caption/hashtag suggestions.",\n      "isEnabled": true\n    },\n    {\n      "name": "Stories",\n      "description": "24-hour disappearing content (images/videos) with smooth transitions.",\n      "isEnabled": true\n    },\n    {\n      "name": "Direct Messaging",\n      "description": "1-on-1 chat with media sharing, real-time updates, and privacy.",\n      "isEnabled": true\n    },\n    {\n      "name": "Dark/Light Mode",\n      "description": "Toggle between dark (default) and light mode for accessibility and aesthetics.",\n      "isEnabled": true\n    },\n    {\n      "name": "Admin Dashboard",\n      "description": "Admin tools to monitor reports, flagged content, and manage users.",\n      "isEnabled": true\n    },\n    {\n      "name": "Responsive UI/UX",\n      "description": "Optimized for mobile and desktop with smooth animations and hover effects.",\n      "isEnabled": true\n    },\n    {\n      "name": "Audio Reels",\n      "description": "Create and share short audio reels (optional feature).",\n      "isEnabled": true\n    },\n    {\n      "name": "Mood-based Filters",\n      "description": "Suggest filters based on user mood or energy (optional feature).",\n      "isEnabled": true\n    },\n    {\n      "name": "AI-generated Captions/Hashtags",\n      "description": "Suggest captions and hashtags using AI (optional feature).",\n      "isEnabled": true\n    },\n    {\n      "name": "Post Scheduling",\n      "description": "Schedule posts for future publishing (optional feature).",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#000000",\n    "secondary": "#FFFFFF",\n    "accent": "#cdcbd2"\n  },\n  "theme": "dark",\n  "layoutDescription": "The UI features a black background with Times New Roman font in white for all text. The main feed is centered, with a left sidebar for navigation (Home, Explore, Messages, Profile, Admin for admins), and a right sidebar for notifications and trending hashtags. Posts are displayed in a card layout with smooth hover and transition effects. Stories appear at the top in a horizontal scroll. The app is fully responsive, adapting to mobile and desktop. Animations and aesthetic touches create a vibey, modern feel. Dark mode is default, with a toggle for light mode."\n}'}",
